{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "node_repl": {
      "command": [
        "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "provider": {
    "alibaba": {
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max"
        },
        "qwen-plus": {
          "name": "Qwen Plus"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "fixture-credential-alpha-0001",
        "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
        "setCacheKey": true
      }
    },
    "relay": {
      "models": {
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "fixture-credential-beta-0002",
        "baseURL": "https://relay.example.com/v1"
      }
    }
  }
}
