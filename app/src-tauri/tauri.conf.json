{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlanDeck",
  "version": "0.1.1",
  "identifier": "com.plandeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlanDeck",
        "width": 980,
        "height": 680,
        "minWidth": 780,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ynotoony/plandeck/releases/download/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRTdCOUJERERENUQxNTgKUldSWTBkWGR2Ym5uU2xHUlNaYi8vQ0tQRXlCWWpaZVhrdkJkOGVhUHVXVTNpaitrZC8yUUVYL3QK"
    }
  }
}
